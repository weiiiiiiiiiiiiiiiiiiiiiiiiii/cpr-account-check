{
  "manifestVersion": 2,
  "name": "cognition-check",
  "publisher": "account-lab",
  "displayName": "账号能力检测",
  "version": "0.1.0",
  "description": "用可编辑题库测试单个或多个账号，并保留回答与历史记录",
  "license": "Apache-2.0",
  "author": "Account Lab",
  "engines": { "codex-proxy-rs": ">=3.21.2, <3.22.0" },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": { "management": {} },
  "configurationSchema": { "type": "object", "properties": {}, "additionalProperties": false },
  "resources": { "web/index.html": "text/html", "web/app.js": "text/javascript", "web/app.css": "text/css" },
  "state": [
    { "namespace": "settings", "schemaVersion": 1, "schema": { "type": "object" }, "maximumRecords": 1, "maximumBytes": 49152, "maximumValueBytes": 49152, "migratesFrom": [] },
    { "namespace": "history", "schemaVersion": 1, "schema": { "type": "object" }, "maximumRecords": 101, "maximumBytes": 4194304, "maximumValueBytes": 49152, "migratesFrom": [] }
  ]
}
